# 根目录通用忽略
# 注意：backend/ 与 frontend/ 各自还有独立的 .gitignore，覆盖各自生态

# IDE / 编辑器
.vs/
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# 操作系统
.DS_Store
Thumbs.db

# 日志
*.log
Logs/
logs/

# 本地数据库与旁路文件
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# 本地配置（共享开发配置与前端公钥继续入库）
.env
.env.local
.env.*.local
appsettings.Local.json
appsettings.*.local.json

# 用户上传文件，仅保留初始化使用的示例头像
/backend/src/Ape.Volo.Web/wwwroot/uploads/**
!/backend/src/Ape.Volo.Web/wwwroot/uploads/**/
!/backend/src/Ape.Volo.Web/wwwroot/uploads/file/avatar/20231010143458_1711631391147429888.png


# .NET 构建产物（backend/ 内也有一份，这里兜底）
[Bb]in/
[Oo]bj/
