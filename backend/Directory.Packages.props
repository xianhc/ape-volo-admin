<Project>

  <!--
    集中管理 NuGet 包版本（Central Package Management）。
    各项目里只写 PackageReference Include，不写 Version；版本一律在本文件维护。

    2026-10 升级：目标框架 net8.0 -> net10.0。
    架构性依赖（SqlSugar / Autofac / Serilog / Swashbuckle / MiniProfiler / xunit）
    只升到 net10 可用版本，不做框架替换。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label=".NET / ASP.NET Core">
    <PackageVersion Include="Microsoft.AspNetCore.Authorization" Version="10.0.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup Label="数据访问 / 缓存">
    <PackageVersion Include="SqlSugarCore" Version="5.1.4.221" />
  </ItemGroup>

  <ItemGroup Label="日志 / 监控">
    <!-- 10.0.0 起依赖 Microsoft.Extensions.* 10.x，System.Text.Json 随之下沉到 10.x（旧版 8.0.0 有 DoS 公告） -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageVersion Include="Elastic.Serilog.Sinks" Version="9.0.0" />
    <PackageVersion Include="MiniProfiler.AspNetCore" Version="4.3.8" />
    <PackageVersion Include="MiniProfiler.AspNetCore.Mvc" Version="4.3.8" />
  </ItemGroup>

  <ItemGroup Label="文档 / 序列化">
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore.Filters" Version="8.0.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup Label="基础设施 / IoC / AOP">
    <PackageVersion Include="Autofac.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageVersion Include="Autofac.Extras.DynamicProxy" Version="7.1.0" />
    <PackageVersion Include="AspNetCoreRateLimit" Version="5.0.0" />
    <PackageVersion Include="Castle.Core.AsyncInterceptor" Version="2.1.0" />
    <PackageVersion Include="Quartz" Version="3.8.0" />
  </ItemGroup>

  <ItemGroup Label="工具 / 扩展">
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.1" />
    <PackageVersion Include="IP2Region.Net" Version="3.0.2" />
    <PackageVersion Include="Mapster" Version="7.4.0" />
    <PackageVersion Include="NodaTime" Version="3.1.10" />
    <PackageVersion Include="Shyjus.BrowserDetector" Version="2.0.0" />
  </ItemGroup>

  <!--
    验证码用 SkiaSharp 自绘（不再依赖 SixLabors.ImageSharp，后者 3.1.x 存在高危漏洞）；
    导出 Excel 用 ClosedXML（不再依赖 DotNetCore.NPOI）；
    邮件发送改用框架内置 System.Net.Mail，不再引用 MailKit/MimeKit。
  -->
  <ItemGroup Label="图像 / 导出">
    <PackageVersion Include="ClosedXML" Version="0.104.2" />
    <PackageVersion Include="SkiaSharp" Version="3.119.2" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.2" />
  </ItemGroup>

  <!--
    传递依赖安全固定（CentralPackageTransitivePinningEnabled=true，此处写版本即可生效）：
    - SQLitePCLRaw.* 来自 SqlSugarCore -> Microsoft.Data.Sqlite，其内置 SQLite 存在 CVE-2025-6965
    - System.Security.Cryptography.Pkcs 来自 SqlSugarCore，10.0.12 及以下存在 2026 年 DoS 公告
    - System.Net.Http 4.3.0 来自 xunit -> NETStandard.Library，仅测试项目命中 CVE-2018-8292
    注意：JSON 序列化统一使用 Newtonsoft.Json，不把 System.Text.Json 作为业务依赖。
  -->
  <ItemGroup Label="传递依赖安全固定">
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="System.Net.Http" Version="4.3.4" />
  </ItemGroup>

  <ItemGroup Label="测试">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.6.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageVersion Include="coverlet.collector" Version="8.0.1" />
  </ItemGroup>

</Project>
